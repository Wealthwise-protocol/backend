{
  "info": {
    "name": "WealthWise Backend API",
    "description": "Complete API collection for WealthWise Investment Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9095",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fundId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sipId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User Authentication",
      "item": [
        {
          "name": "1.1 Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "    pm.test('Token saved', function() {",
                  "        pm.expect(jsonData.token).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"test{{$timestamp}}@example.com\",\n  \"phone\": \"98765{{$randomInt}}\",\n  \"countryCode\": \"+91\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "1.2 Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signin"]
            }
          }
        },
        {
          "name": "1.3 Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "1.4 Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "1.5 Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"SecurePass123\",\n  \"newPassword\": \"NewSecurePass456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            }
          }
        },
        {
          "name": "1.6 Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "1.7 Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-from-email\",\n  \"newPassword\": \"NewPassword789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            }
          }
        },
        {
          "name": "1.8 Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signout"]
            }
          }
        },
        {
          "name": "1.9 Delete Account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/account",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "account"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Funds Management",
      "item": [
        {
          "name": "2.1 Search Funds (All)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.content && jsonData.content.length > 0) {",
                  "        pm.collectionVariables.set('fundId', jsonData.content[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funds?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["funds"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "2.2 Search Funds (with filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funds?page=0&size=10&search=axis&category=Equity",
              "host": ["{{baseUrl}}"],
              "path": ["funds"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "axis"
                },
                {
                  "key": "category",
                  "value": "Equity"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Get Fund Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{fundId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/funds",
              "host": ["{{baseUrl}}"],
              "path": ["funds"]
            }
          }
        },
        {
          "name": "2.4 Get NAV History (1Y)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funds/{{fundId}}/nav-history?period=1Y",
              "host": ["{{baseUrl}}"],
              "path": ["funds", "{{fundId}}", "nav-history"],
              "query": [
                {
                  "key": "period",
                  "value": "1Y"
                }
              ]
            }
          }
        },
        {
          "name": "2.5 Get NAV History (3M)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funds/{{fundId}}/nav-history?period=3M",
              "host": ["{{baseUrl}}"],
              "path": ["funds", "{{fundId}}", "nav-history"],
              "query": [
                {
                  "key": "period",
                  "value": "3M"
                }
              ]
            }
          }
        },
        {
          "name": "2.6 Invest (SIP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SIP\",\n  \"amount\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/funds/{{fundId}}/invest",
              "host": ["{{baseUrl}}"],
              "path": ["funds", "{{fundId}}", "invest"]
            }
          }
        },
        {
          "name": "2.7 Invest (Lumpsum)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Lumpsum\",\n  \"amount\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/funds/{{fundId}}/invest",
              "host": ["{{baseUrl}}"],
              "path": ["funds", "{{fundId}}", "invest"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Bookmarks",
      "item": [
        {
          "name": "3.1 Get Bookmarks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookmarks",
              "host": ["{{baseUrl}}"],
              "path": ["bookmarks"]
            }
          }
        },
        {
          "name": "3.2 Add Bookmark",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookmarks/{{fundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookmarks", "{{fundId}}"]
            }
          }
        },
        {
          "name": "3.3 Remove Bookmark",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookmarks/{{fundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookmarks", "{{fundId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. SIP Management",
      "item": [
        {
          "name": "4.1 Get User SIPs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sips",
              "host": ["{{baseUrl}}"],
              "path": ["sips"]
            }
          }
        },
        {
          "name": "4.2 Create SIP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('sipId', jsonData.sip.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fundId\": \"{{fundId}}\",\n  \"monthlyAmt\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sips",
              "host": ["{{baseUrl}}"],
              "path": ["sips"]
            }
          }
        },
        {
          "name": "4.3 Update SIP (Amount)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sipId\": \"{{sipId}}\",\n  \"monthlyAmt\": 7000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sips",
              "host": ["{{baseUrl}}"],
              "path": ["sips"]
            }
          }
        },
        {
          "name": "4.4 Update SIP (Pause)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sipId\": \"{{sipId}}\",\n  \"status\": \"PAUSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sips",
              "host": ["{{baseUrl}}"],
              "path": ["sips"]
            }
          }
        },
        {
          "name": "4.5 Update SIP (Activate)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sipId\": \"{{sipId}}\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sips",
              "host": ["{{baseUrl}}"],
              "path": ["sips"]
            }
          }
        },
        {
          "name": "4.6 Delete SIP",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sips?id={{sipId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sips"],
              "query": [
                {
                  "key": "id",
                  "value": "{{sipId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
